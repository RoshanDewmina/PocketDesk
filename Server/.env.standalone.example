# Store the filled file outside the repository with mode 600.
NODE_ENV=production
BIND=127.0.0.1
PORT=28787

# Create only the approved file outside the repository. It may start empty.
# The service creates the pending file; its parent directory must already exist.
APPROVED_ROOMS_FILE=/absolute/private/path/approved-rooms
PENDING_ROOMS_FILE=/absolute/private/path/pending-rooms.json
PENDING_ROOM_TTL_SECONDS=300
APPROVAL_AUDIT_INTERVAL_MS=1000

TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=replace-with-turn-key-id
CLOUDFLARE_TURN_KEY_API_TOKEN=replace-with-server-only-turn-key-api-token
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_PROVIDER_TIMEOUT_MS=3000
AUTH_TIMEOUT_MS=5000

# One host plus one phone, with a small reconnect margin.
MAX_PEERS=4
CONNECTION_ATTEMPTS_PER_MINUTE=20
MESSAGES_PER_SECOND=100
TURN_CREDENTIAL_ISSUES_PER_MINUTE=8
ROOM_LIFETIME_SECONDS=1800
