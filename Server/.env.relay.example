# PocketDesk Cloudflare relay: NON-SECRET configuration template.
# `bun scripts/relay-env.ts init --host <host>` renders this into @RELAY_HOME@/relay.env (mode 600).
# The TURN key ID and API token live in macOS Keychain, never in this file:
#   service pocketdesk.cloudflare.turn-key-id    (account = your login user)
#   service pocketdesk.cloudflare.turn-api-token (account = your login user)
NODE_ENV=production
BIND=127.0.0.1
PORT=28787

@PD_PUBLIC_HOST_LINE@
PD_TUNNEL_NAME=@TUNNEL_NAME@

POCKETDESK_SECRET_SOURCE=keychain
POCKETDESK_KEYCHAIN_SLOT=a

APPROVED_ROOMS_FILE=@RELAY_HOME@/approved-rooms
PENDING_ROOMS_FILE=@RELAY_HOME@/pending-rooms.json
PENDING_ROOM_TTL_SECONDS=300
APPROVAL_AUDIT_INTERVAL_MS=1000

TURN_PROVIDER=cloudflare
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_PROVIDER_TIMEOUT_MS=3000
AUTH_TIMEOUT_MS=5000

# One Mac plus one phone with a small reconnect margin; each session issues two credentials.
MAX_PEERS=4
CONNECTION_ATTEMPTS_PER_MINUTE=20
MESSAGES_PER_SECOND=100
TURN_CREDENTIAL_ISSUES_PER_MINUTE=8
ROOM_LIFETIME_SECONDS=1800

# 1 forces every session onto the TURN relay (acceptance test only).
POCKETDESK_TEST_FORCE_RELAY=0
