# Store the filled file outside the repository with service-account-only permissions.
NODE_ENV=production
BIND=127.0.0.1
PORT=8787

# Static option: SHA-256 room ID(s), never the host or client token.
ALLOWED_ROOMS=replace-with-64-character-lowercase-hex-room-id

# Dynamic first-pairing option: use these instead of ALLOWED_ROOMS. Both paths
# must be absolute and outside the repository; create approved-rooms with mode 600.
# APPROVED_ROOMS_FILE=/absolute/private/path/approved-rooms
# PENDING_ROOMS_FILE=/absolute/private/path/pending-rooms.json
# PENDING_ROOM_TTL_SECONDS=300
# APPROVAL_AUDIT_INTERVAL_MS=1000

TURN_PROVIDER=cloudflare
CLOUDFLARE_TURN_KEY_ID=replace-with-turn-key-id
CLOUDFLARE_TURN_KEY_API_TOKEN=replace-with-server-only-turn-key-api-token
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_PROVIDER_TIMEOUT_MS=3000
AUTH_TIMEOUT_MS=5000

MAX_PEERS=16
CONNECTION_ATTEMPTS_PER_MINUTE=30
MESSAGES_PER_SECOND=100
TURN_CREDENTIAL_ISSUES_PER_MINUTE=12
# Room lease. Apps that renew (renew.1) extend it while connected, so sessions run as long as
# the Mac and phone stay connected and the room stays approved; apps that do not renew end here.
# It must stay below TURN_CREDENTIAL_TTL_SECONDS. Set SESSION_RENEWAL=0 to make it a hard cap again.
ROOM_LIFETIME_SECONDS=1800
SESSION_RENEWAL=1

# Coturn alternative: replace the Cloudflare variables above with these values.
# TURN_PROVIDER=coturn
# TURN_URLS=turn:relay.private.example:3478?transport=udp,turns:relay.private.example:5349?transport=tcp
# TURN_SECRET=replace-with-at-least-32-random-characters
