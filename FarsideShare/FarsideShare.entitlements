<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Send to My Mac hands one staged item and the app's beacon through this group.
	     Keep aligned with SendToMacOutbox.appGroup and the app's entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.roshan.PocketDesk</string>
	</array>
</dict>
</plist>
