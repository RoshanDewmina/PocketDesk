{
  "handlers": {
    "thread/start": {
      "resultSequence": [
        { "thread": { "id": "thread-1", "sessionId": "session-1", "status": { "type": "idle" }, "cwd": "/tmp", "path": null, "turns": [] } }
      ]
    },
    "turn/start": {
      "resultSequence": [{ "turn": { "id": "turn-1", "items": [], "itemsView": "full", "status": "inProgress", "error": null, "startedAt": 0, "completedAt": null, "durationMs": null } }],
      "notifications": [
        { "method": "turn/started", "params": { "threadId": "thread-1", "turn": { "id": "turn-1", "items": [], "itemsView": "full", "status": "inProgress", "error": null, "startedAt": 0, "completedAt": null, "durationMs": null } } }
      ]
    },
    "turn/interrupt": { "resultSequence": [{}] },
    "thread/backgroundTerminals/list": { "resultSequence": [{ "data": [], "nextCursor": null }] }
  },
  "serverRequests": [
    {
      "afterMethod": "turn/interrupt",
      "delayMs": 5,
      "id": 9001,
      "method": "item/commandExecution/requestApproval",
      "params": { "threadId": "thread-1", "turnId": "turn-1", "itemId": "item-1", "command": "rm -rf /tmp/whatever" },
      "onResponse": {
        "notifications": [
          {
            "method": "turn/completed",
            "params": {
              "threadId": "thread-1",
              "turn": { "id": "turn-1", "items": [], "itemsView": "full", "status": "interrupted", "error": null, "startedAt": 0, "completedAt": 1, "durationMs": 5 }
            }
          },
          { "method": "thread/status/changed", "params": { "threadId": "thread-1", "status": { "type": "idle" } } }
        ]
      }
    }
  ]
}
