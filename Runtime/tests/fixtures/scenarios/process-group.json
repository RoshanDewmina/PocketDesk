{
  "spawnChildProcessPidFile": "__PID_FILE__",
  "handlers": {
    "thread/start": {
      "resultSequence": [
        { "thread": { "id": "thread-1", "sessionId": "session-1", "status": { "type": "idle" }, "cwd": "/tmp", "path": null, "turns": [] } }
      ]
    },
    "turn/start": {
      "resultSequence": [{ "turn": { "id": "turn-1", "items": [], "itemsView": "full", "status": "inProgress", "error": null, "startedAt": 0, "completedAt": null, "durationMs": null } }],
      "notifications": [
        { "method": "turn/started", "params": { "threadId": "thread-1", "turn": { "id": "turn-1", "items": [], "itemsView": "full", "status": "inProgress", "error": null, "startedAt": 0, "completedAt": null, "durationMs": null } } }
      ]
    }
  }
}
