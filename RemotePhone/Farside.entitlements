<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OFF by default. Nothing here is in a normal build, because each key needs an explicit App ID
	     with the capability registered, and a build signed with Xcode's wildcard development profile
	     fails to sign with any of them. Turn them all on together with FARSIDE_ENABLE_PUSH=YES, after
	     the steps in design/SYSTEM-INTEGRATIONS-REPORT.md ("Turning push on"). -->

	<!-- Shared with Info.plist; archive validation checks the signed APNs environment. -->
	<key>aps-environment</key>
	<string>$(FARSIDE_APNS_ENVIRONMENT)</string>
	<!-- Time Sensitive Notifications: agent alerts that light the screen through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Keep aligned with FarsideRoute and the launch AASA artifact. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:getfarside.com</string>
	</array>
</dict>
</plist>
