<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.roshan.PocketDesk.RemoteHost.watchdog</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/FarsideWatchdog</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.roshan.PocketDesk.RemoteHost</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
